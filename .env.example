# ── Reddit OAuth2 ──────────────────────────────────────────────────────────────
# Register your app at https://www.reddit.com/prefs/apps → "script" type
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Anthropic (prod classifier only — leave blank for local Ollama dev) ────────
ANTHROPIC_API_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://wantedby:wantedby@localhost:5432/wantedby_db

# ── Auth0 ──────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Sentry (optional for local dev) ────────────────────────────────────────────
SENTRY_DSN=

# ── Classifier tuning ──────────────────────────────────────────────────────────
CLASSIFIER_WORKERS=3
DAILY_TOKEN_BUDGET_USD=5.00
