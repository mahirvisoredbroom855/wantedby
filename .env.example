# ── Reddit (via RapidAPI "Reddit34" — Basic/free tier, manual testing only) ────
# Stopgap until Reddit's official Data Access Request is approved.
# Get key at: rapidapi.com/socialminer/api/reddit34 → Pricing → Basic plan
REDDIT_RAPIDAPI_KEY=
REDDIT_RAPIDAPI_HOST=reddit34.p.rapidapi.com

# ── Reddit OAuth2 (official — currently blocked pending Data Access approval) ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Anthropic (prod classifier only — leave blank for local Ollama dev) ────────
ANTHROPIC_API_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local dev runs on port 5433, not the default 5432 -- another unrelated project's
# Postgres container already occupies 5432 on this machine. Production/Docker
# Compose environments should use the standard 5432.
DATABASE_URL=postgresql://wantedby:wantedby@localhost:5433/wantedby_db

# ── Auth0 ──────────────────────────────────────────────────────────────────────
# Dashboard: manage.auth0.com → Applications → APIs → create "WantedBy API"
# AUTH0_AUDIENCE is the API Identifier you set in Auth0 (e.g. https://api.wantedby.io)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@wantedby.io

# ── Sentry (optional for local dev) ────────────────────────────────────────────
SENTRY_DSN=

# ── Frontend (Vite env vars — copy to frontend/.env for local dev) ─────────────
# VITE_AUTH0_DOMAIN mirrors AUTH0_DOMAIN above
# VITE_AUTH0_CLIENT_ID comes from Auth0 → Applications → SPA app → Settings
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.wantedby.io
VITE_API_URL=http://localhost:4000

# ── API service ────────────────────────────────────────────────────────────────
PORT=4000

# ── Classifier tuning ──────────────────────────────────────────────────────────
CLASSIFIER_WORKERS=3
DAILY_TOKEN_BUDGET_USD=5.00
